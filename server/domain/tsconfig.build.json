{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "..",
    "outDir": "../dist",
    "sourceMap": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
