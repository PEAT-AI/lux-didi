{
  "name": "@lux-didi/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/test/fixtures && cp test/fixtures/*.mjs dist/test/fixtures/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "node --test --test-timeout=15000 dist/test/runtime.test.js dist/test/http.test.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.2",
    "@types/ws": "8.18.2"
  },
  "files": [
    "dist",
    "!dist/test",
    "adapters/mcp/SDK-LICENSE.txt"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "ws": "8.22.0"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/client",
    "ws"
  ]
}
