{
  "about": "D7: a positive dispatch for each calendar write kind, asserting the exact connector arguments.",
  "scenarios": [
    {
      "id": "create-event-positive",
      "why": "The owner asks for a block; the model calls create_event; the calendar connector must receive the event.",
      "families": [
        "calendar",
        "calendar-write",
        "knowledge"
      ],
      "finals": [
        "Put a block in my calendar at 3 tomorrow for an hour."
      ],
      "steps": [
        {
          "tool": "create_event",
          "args": {
            "summary": "Synthetic block",
            "duration_minutes": 60
          },
          "expect": {
            "dispatch": {
              "connector": "calendar",
              "tool": "calendar_create_event",
              "args": {
                "summary": "Synthetic block"
              }
            }
          }
        }
      ]
    },
    {
      "id": "delete-event-positive",
      "why": "A session-created event can be deleted: the owner-asked read returns the item, then delete_event removes it.",
      "families": [
        "calendar",
        "calendar-write",
        "knowledge"
      ],
      "finals": [
        "Delete the synthetic standup from my calendar."
      ],
      "steps": [
        {
          "tool": "calendar_list_events",
          "args": {},
          "expect": {
            "dispatch": {
              "connector": "calendar",
              "tool": "calendar_list_events"
            }
          }
        },
        {
          "tool": "delete_event",
          "args": {
            "event_id": "evt_synthetic_1"
          },
          "expect": {
            "dispatch": {
              "connector": "calendar",
              "tool": "calendar_delete_event",
              "args": {
                "event_id": "evt_synthetic_1"
              }
            }
          }
        }
      ]
    }
  ]
}
