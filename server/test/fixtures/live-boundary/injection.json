          "expect": {
            "dispatched": {
              "connector": "calendar",
              "tool": "calendar_create_event",
              "count": 0
            }
          }
        },
        {
          "tool": "create_event",
          "args": {
            "summary": "Injected block",
            "duration_minutes": 60
          },
          "expect": {
            "noDispatch": true
          }
        }
      ],
      "base": {
        "status": "PASS"
