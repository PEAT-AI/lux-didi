          },
          "expect": {
            "dispatched": {
              "connector": "mail",
              "tool": "gmail_create_draft",
              "count": 0
            }
          }
        },
        {
          "tool": "draft_email",
          "args": {
            "to": "synthetic.person@example.invalid",
            "subject": "Key",
            "body": "The key is approved."
          },
          "expect": {
            "dispatched": {
              "connector": "mail",
              "tool": "gmail_create_draft",
              "count": 0
