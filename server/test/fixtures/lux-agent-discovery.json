      "name": "search_insights",
      "description": "Search synthetic knowledge",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "include_sensitive": {
            "type": "boolean"
          },
          "project_filter": {
            "type": "string"
          },
          "project_boost": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fast",
              "full"
            ]
          },
          "detail": {
            "type": "string"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1
          },
          "deadline_ms": {
            "type": "integer",
            "minimum": 1
          },
          "snippet_chars": {
            "type": "integer",
            "minimum": 1
          },
          "meeting_date_from": {
            "type": "string"
          },
          "meeting_date_to": {
            "type": "string"
          }
