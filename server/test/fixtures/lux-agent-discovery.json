    {
      "name": "create_insight",
      "description": "Create a durable insight with idempotency and candidate receipts",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1
          },
          "insight_title": {
            "type": "string"
          },
          "insight_type": {
            "type": "string",
            "enum": [
              "TECHNICAL_DECISION",
              "BUG_GOTCHA",
              "PATTERN",
              "MEETING",
              "USER_PREFERENCE",
              "PROJECT_CONSTRAINT",
              "UNCATEGORIZED"
            ]
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "force": {
            "type": "boolean"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "voice_call",
              "agent_session",
              "meeting",
              "manual"
            ]
          },
          "source_ref": {
            "type": "object",
            "properties": {
              "app": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "turn_start_id": {
                "type": "string"
              },
              "turn_end_id": {
                "type": "string"
              },
              "spoken_at": {
                "type": "string"
              }
            },
            "required": [
              "app",
              "session_id"
            ],
            "additionalProperties": false
          },
          "quote": {
            "type": "string",
            "maxLength": 600
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "follow_up_state": {
            "type": "string",
            "enum": [
              "none",
              "open",
              "closed"
            ]
          }
        },
        "required": [
          "content",
          "insight_title",
          "insight_type"
        ],
        "additionalProperties": false
      }
    },
